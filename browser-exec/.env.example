MIDDLEWARE_URL=https://orders-dashboard-eight-sepia.vercel.app
HEADLESS=false
PW_PROFILE=.pw-profile
PORT=4001

# MongoDB Atlas — leave MONGODB_URI empty to use the in-memory store
MONGODB_URI=
MONGODB_DB=ownerorbit
MONGODB_RUNS_COLLECTION=action_runs
MONGODB_AUDIT_COLLECTION=audit_events

# Raindrop — `raindrop cloud setup` writes RAINDROP_WRITE_KEY into .env for you
RAINDROP_WRITE_KEY=
RAINDROP_DEBUG=false

# Demo only: makes status skills fail honestly to show the Raindrop failure → v2 loop
SIMULATE_UI_CHANGE=false
