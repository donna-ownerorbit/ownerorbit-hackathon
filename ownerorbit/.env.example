# Sandbox (the Vercel dashboard Donna drives)
SANDBOX_URL=https://orders-dashboard-eight-sepia.vercel.app
# live | isolated | auto  (auto probes /api/health; if the DB is down, /api is stubbed so the app runs in local mode instantly)
SANDBOX_API=auto
HEADLESS=true

# Who may text Donna, and their role: owner | manager | staff
OWNERORBIT_PRINCIPALS={"+15105550100":"owner"}

# BlueBubbles (iMessage transport)
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=
PORT=8787

# Planner: rules | llm | hybrid | agent  (agent = grammar first, Claude Haiku agent loop for the rest; default)
# (hybrid = deterministic grammar first, Claude for anything it can't parse)
PLANNER=hybrid
ANTHROPIC_API_KEY=
OWNERORBIT_MODEL=claude-opus-5-5

# Evidence + tracing (both optional; JSONL fallback in .data/)
MONGODB_URI=
MONGODB_DB=ownerorbit
RAINDROP_WRITE_KEY=

# Haiku agent + MongoDB inbox
OWNERORBIT_AGENT_MODEL=claude-haiku-5-5
RESTAURANT_ID=falafel-flare
# on: iMessages flow through ownerorbit.inbound_messages and the worker (needs MONGODB_URI). off: handled inline.
OWNERORBIT_INBOX=on
# Reply "not on the staff list" to unknown numbers (default false = silent, still logged in inbound_messages)
REPLY_TO_UNKNOWN=false

# GitHub → MongoDB → agent: Saddiq's side commits briefs to this repo; the worker pulls new commits
# into ownerorbit.github_commits and runs each through the Haiku agent (reply stored on the commit + texted to the author).
GITHUB_REPO=
GITHUB_BRANCH=main
# Only changes under these prefixes count (comma-separated; empty = whole repo)
GITHUB_PATHS=briefs
# Optional: falls back to `gh auth token`
GITHUB_TOKEN=
# Commit author (GitHub login or email) → principal phone. Or: npm run principals -- add <phone> owner "Name" --github <login>
GITHUB_PRINCIPALS={}
GITHUB_MESSAGES_DIR=messages
GITHUB_REPLIES_DIR=replies
GITHUB_POLL_MS=10000
GITHUB_BACKFILL=1
# Set to enable POST /github/webhook (GitHub push webhook, instant pull)
GITHUB_WEBHOOK_SECRET=

# iMessage transport: auto (real when URL+password set, else mock) | real | mock. /phone always uses the mock.
BLUEBUBBLES_MODE=auto
DEMO_PHONE=+15550001234
# browser-exec (../browser-exec, npm run dev). Empty = built-in skills only.
BROWSER_EXEC_URL=http://localhost:4001
# Team harness bridge (audit_events → Donna): off | fallback | all
HARNESS_BRIDGE=off
